        clean. Dark variants live in values-night/colors.xml.
    -->
    <color name="note_default">#FFFFFF</color>
    <color name="note_red">#F9DEDC</color>
    <color name="note_orange">#FDE7D3</color>
    <color name="note_yellow">#FEF3C7</color>
    <color name="note_green">#DDF0E0</color>
    <color name="note_blue">#DCEBF7</color>
    <color name="note_purple">#E9E0F7</color>
</resources>
